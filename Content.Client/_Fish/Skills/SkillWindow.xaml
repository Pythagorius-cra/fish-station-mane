<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      Title="{Loc 'skills-window-title'}"
                      MinSize="520 480"
                      SetSize="560 520">
    <BoxContainer Orientation="Vertical" Margin="8" SeparationOverride="6">
        <controls:StripeBack>
            <Label Name="HeaderLabel"
                   Align="Center"
                   StyleClasses="LabelHeading"
                   Margin="4"/>
        </controls:StripeBack>

        <BoxContainer Orientation="Horizontal">
            <Label Text="{Loc 'skills-window-points'}" StyleClasses="LabelKeyText"/>
            <Label Name="PointsLabel" Margin="8 0 0 0"/>
        </BoxContainer>

        <Label Name="StatusLabel" Align="Center" Visible="False"/>

        <ScrollContainer VerticalExpand="True" HorizontalExpand="True">
            <BoxContainer Name="SkillsContainer" Orientation="Vertical" SeparationOverride="6"/>
        </ScrollContainer>

        <BoxContainer Orientation="Horizontal" SeparationOverride="8">
            <Button Name="ResetButton"
                    Text="{Loc 'skills-window-reset'}"
                    HorizontalExpand="True"/>
            <Button Name="ConfirmButton"
                    Text="{Loc 'skills-window-confirm'}"
                    HorizontalExpand="True"
                    StyleClasses="Caution"/>
        </BoxContainer>
    </BoxContainer>
</controls:FancyWindow>
