fish-slime-name = { $color } { $stage } slime ({ $number })
fish-slime-examine =
    Nutrition { $nutrition }/{ $max }. Growth { $grown }/{ $need }. Mutation { $mutation }%. Cores { $cores }. Power { $power }.
    { $adult ->
        [true] Adult.
       *[false] Baby.
    }{ $rabid ->
        [true] Rabid.
       *[false] {""}
    }{ $docile ->
        [true] Docile.
       *[false] {""}
    }{ $trained ->
        [true] Trained.
       *[false] {""}
    }
