fish-slime-name = { $color } { $stage }-слайм ({ $number })
fish-slime-examine =
    Питание { $nutrition }/{ $max }. Рост { $grown }/{ $need }. Мутация { $mutation }%. Ядра { $cores }. Заряд { $power }.
    { $adult ->
        [true] Взрослый.
       *[false] Малыш.
    }{ $rabid ->
        [true] Бешеный.
       *[false] {""}
    }{ $docile ->
        [true] Ручной.
       *[false] {""}
    }{ $trained ->
        [true] Обучен.
       *[false] {""}
    }
fish-slime-verb-evolve = Эволюционировать
fish-slime-verb-reproduce = Разделиться
fish-slime-not-ready = Ещё не готов.
fish-slime-plasma-need-five = Нужно хотя бы пять листов плазмы.
fish-slime-plasma-fed = Слайм довольно булькает. Плазма вкусная.
fish-slime-trained = Слайм обучен.
fish-slime-spooked = Слайм пугается и забывает обучение.
fish-slime-sorry = Прости...
fish-slime-no-food = Рядом некого есть.
fish-slime-latched = Присосался к { $target }.
